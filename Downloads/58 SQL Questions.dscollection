                  "props": {
                    "backgroundColor": "default",
                    "textColor": "default",
                    "textAlignment": "left"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "- Why can't the WHERE clause be used to filter on the result of an aggregate function, and what clause should be used instead? ",
                      "styles": {}
                    }
                  ],
                  "children": []
                },
                {
                  "id": "fa0cd5b9-269d-4825-b6e4-d4f78db4dea5",
