                    "backgroundColor": "default",
                    "textColor": "default",
                    "textAlignment": "left"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "- Can you use aggregate functions like SUM() or AVG() without a GROUP BY clause, and what happens when you do? ",
                      "styles": {}
                    }
                  ],
                  "children": []
